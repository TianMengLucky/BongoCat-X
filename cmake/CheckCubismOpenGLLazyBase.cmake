cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/CubismShaderOptimize.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CubismOpenGLLazyBase.cmake")
if(NOT DEFINED SDK OR SDK STREQUAL "")
  get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
  set(SDK "${ROOT}/vendor/CubismSdkForNative")
endif()
set(renderer "${SDK}/Framework/src/Rendering/OpenGL/CubismShader_OpenGLES2.cpp")
if(NOT EXISTS "${renderer}")
  message(STATUS "OpenGL lazy shader check skipped: local SDK absent")
  return()
endif()
file(SHA256 "${renderer}" before)
file(READ "${renderer}" source)
string(REPLACE "\r\n" "\n" source "${source}")
if(MUTATION STREQUAL "missing")
  string(REPLACE "void CubismShader_OpenGLES2::GenerateShaders()" "changed_shader_setup()" source "${source}")
endif()
bongo_cat_gl_lazy_base(source)
foreach(required IN ITEMS "#ifndef CSM_TARGET_ANDROID_ES2" "*shaderSet = *base;"
    "if (!base->ShaderProgram)" "if (vertShader) glDeleteShader(vertShader);"
    "if (!shaderSet->ShaderProgram)" "Cannot create Live2D OpenGL SetupMask shader")
  string(FIND "${source}" "${required}" position)
  if(position LESS 0)
    message(FATAL_ERROR "OpenGL lazy shader behavior missing: ${required}")
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSDK=${SDK}" "-DMUTATION=missing"
  -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "OpenGL lazy shader initialization changed")
  message(FATAL_ERROR "OpenGL lazy shader accepted incompatible SDK: ${error}")
endif()
file(SHA256 "${renderer}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "OpenGL lazy shader patch modified user SDK")
endif()
message(STATUS "OpenGL lazy base shaders, alias ownership and failure cleanup passed")
