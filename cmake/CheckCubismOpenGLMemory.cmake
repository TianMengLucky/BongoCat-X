cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/CubismShaderOptimize.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CubismOpenGLMasks.cmake")
if(NOT DEFINED ROOT)
  get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
if(NOT DEFINED SDK)
  set(SDK "${ROOT}/vendor/CubismSdkForNative")
endif()
set(renderer "${SDK}/Framework/src/Rendering/OpenGL/CubismRenderer_OpenGLES2.cpp")
if(NOT EXISTS "${renderer}")
  message(STATUS "OpenGL memory patch check skipped: local SDK absent")
  return()
endif()
file(SHA256 "${renderer}" original_hash)
file(READ "${renderer}" source)
string(REPLACE "\r\n" "\n" source "${source}")
if(DEFINED MUTATION)
  string(REPLACE "_${MUTATION}Masks.Clear();" "changed_masks();" source "${source}")
endif()
bongo_cat_gl_mask_counts(source)
foreach(kind IN ITEMS drawable offscreen)
  foreach(required IN ITEMS "native_mask_counts.${kind} : maskBufferCount;"
      "*model,\n            ${kind}MaskCount,"
      "i < ${kind}MaskCount; ++i)")
    string(FIND "${source}" "${required}" found)
    if(found LESS 0)
      message(FATAL_ERROR "Independent OpenGL mask allocation missing: ${required}")
    endif()
  endforeach()
endforeach()
foreach(kind IN ITEMS drawable offscreen)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DSDK=${SDK}" "-DMUTATION=${kind}"
    -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "shader patch mismatch")
    message(FATAL_ERROR "OpenGL memory patch accepted a changed SDK: ${kind}")
  endif()
endforeach()
file(SHA256 "${renderer}" current_hash)
if(NOT original_hash STREQUAL current_hash)
  message(FATAL_ERROR "OpenGL memory patch modified user SDK sources")
endif()
message(STATUS "Independent OpenGL mask counts and SDK mismatch checks passed")
