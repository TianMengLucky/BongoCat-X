cmake_minimum_required(VERSION 3.24)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED SDK)
  set(SDK "${ROOT}/vendor/CubismSdkForNative")
endif()
set(base "${SDK}/Framework/src/Rendering")
if(NOT EXISTS "${base}/Vulkan/CubismRenderer_Vulkan.cpp")
  message(STATUS "Renderer streaming check skipped: local SDK absent")
  return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CubismMetalGeometry.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CubismNativeMasks.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CubismVulkanVertexUpload.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CubismVulkanRecording.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CubismVulkanStreaming.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CubismCoreProfile.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CubismGLStreaming.cmake")
foreach(name IN ITEMS Metal/CubismRenderer_Metal.mm Metal/CubismCommandBuffer_Metal.mm
    Metal/CubismShader_Metal.mm Vulkan/CubismRenderer_Vulkan.cpp OpenGL/CubismShader_OpenGLES2.cpp
    OpenGL/CubismRenderTarget_OpenGLES2.cpp)
  file(SHA256 "${base}/${name}" before)
  file(READ "${base}/${name}" source)
  string(REPLACE "\r\n" "\n" source "${source}")
  if(name STREQUAL "Metal/CubismRenderer_Metal.mm")
    if(MUTATION STREQUAL "metal")
      string(REPLACE "CreateVertexBuffer(_device, vertexSize, drawableVertexCount);"
        "changed_vertex_allocation();" source "${source}")
    endif()
    bongo_cat_metal_geometry_renderer(source)
    bongo_cat_metal_cache_state(source)
    bongo_cat_native_masks_patch(source Metal)
    set(required "metal_geometry_available();metal_set_pipeline(;native_mask_sizes")
  elseif(name STREQUAL "Metal/CubismCommandBuffer_Metal.mm")
    bongo_cat_metal_geometry_commands(source)
    set(required "metal_geometry_update(this, data);memcmp(dest, sourceIndices, length);memset([_indices contents]")
  elseif(name STREQUAL "Metal/CubismShader_Metal.mm")
    bongo_cat_metal_geometry_shader(source)
    bongo_cat_metal_cache_state(source)
    set(required "metal_geometry_offset(drawCommandBuffer, true);metal_geometry_offset(drawCommandBuffer, false);metal_set_texture(renderEncoder, offscreen->GetRenderTarget()->GetColorBuffer(), 0)")
  elseif(name STREQUAL "Vulkan/CubismRenderer_Vulkan.cpp")
    if(MUTATION STREQUAL "vulkan")
      string(REPLACE "if (vcount != 0)" "if (changed_vertex_count)" source "${source}")
    endif()
    bongo_cat_vulkan_vertex_upload_patch(source)
    bongo_cat_vulkan_recording_patch(source)
    bongo_cat_vulkan_stream_state_patch(source)
    bongo_cat_native_masks_patch(source Vulkan)
    set(required "vulkan_geometry_upload(commandBuffer);vulkan_geometry_offset((size_t)index);vulkan_submit(commandBuffer;vulkan_begin_commands(;vulkan_create_pipelines(;native_mask_sizes")
  elseif(name STREQUAL "OpenGL/CubismRenderTarget_OpenGLES2.cpp")
    string(ASCII 239 187 191 utf8_bom)
    set(source "${utf8_bom}${source}")
    bongo_cat_gl_cache_state(source)
    string(FIND "${source}" "${utf8_bom}" bom_position)
    if(NOT bom_position EQUAL -1)
      message(FATAL_ERROR "Generated render target retains an embedded UTF-8 BOM")
    endif()
    set(required "gl_bind_texture(;gl_delete_textures(")
  else()
    if(MUTATION STREQUAL "opengl")
      string(REPLACE "glVertexAttribPointer(shaderSet->AttributePosition" "changed_vertex_attribute(shaderSet->AttributePosition" source "${source}")
    endif()
    bongo_cat_core_profile_patch_shader(source)
    bongo_cat_gl_cache_state(source)
    set(required "CoreProfileBinding::attribute(;gl_bind_texture(;gl_use_program(")
  endif()
  foreach(anchor IN LISTS required)
    string(FIND "${source}" "${anchor}" found)
    if(found EQUAL -1)
      message(FATAL_ERROR "Renderer streaming behavior missing: ${name}: ${anchor}")
    endif()
  endforeach()
  file(SHA256 "${base}/${name}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Renderer streaming modified the supplied SDK")
  endif()
endforeach()
if(DEFINED MUTATION)
  message(FATAL_ERROR "Renderer streaming accepted incompatible SDK: ${MUTATION}")
endif()
foreach(mutation IN ITEMS metal vulkan opengl)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DSDK=${SDK}" "-DMUTATION=${mutation}"
    -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
  if(result EQUAL 0 OR error MATCHES "accepted incompatible")
    message(FATAL_ERROR "Renderer streaming mismatch rejection failed: ${mutation}: ${error}")
  endif()
endforeach()
message(STATUS "OpenGL/Vulkan/Metal streaming, mask and incompatible-SDK checks passed")
