function(bongo_cat_gl_cache_state variable)
  set(source "${${variable}}")
  string(ASCII 239 187 191 utf8_bom)
  string(REPLACE "${utf8_bom}" "" source "${source}")
  foreach(pair IN ITEMS "glUseProgram;gl_use_program" "glActiveTexture;gl_active_texture"
      "glBindTexture;gl_bind_texture" "glBlendFuncSeparate;gl_blend_func"
      "glDeleteTextures;gl_delete_textures" "glDeleteProgram;gl_delete_program")
    list(GET pair 0 original)
    list(GET pair 1 replacement)
    string(REPLACE "${original}(" "bongo_cat::${replacement}(" source "${source}")
  endforeach()
  set(${variable} "#include \"cubism_gl_state.hpp\"\n${source}" PARENT_SCOPE)
endfunction()
function(bongo_cat_gl_patch_render_targets target)
  set(original "${CUBISM_FRAMEWORK_PATH}/src/Rendering/OpenGL/CubismRenderTarget_OpenGLES2.cpp")
  file(READ "${original}" source)
  bongo_cat_gl_cache_state(source)
  set(output "${CMAKE_BINARY_DIR}/generated/cubism/CubismRenderTarget_cached.cpp")
  bongo_cat_write_if_different("${output}" "${source}")
  get_target_property(sources ${target} SOURCES)
  list(REMOVE_ITEM sources "${original}")
  set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
  target_sources(${target} PRIVATE "${output}")
endfunction()
